{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "threads": [
        "./node_modules/threads/dist/index.d.ts"
      ],
      "@dcapal/api-client": [
        "../packages/api-client/src/index.ts"
      ],
      "@dcapal/api-client/mocks": [
        "../packages/api-client/src/gen-mocks/index.ts"
      ],
      "@dcapal/api-client/model": [
        "../packages/api-client/src/gen/model/index.ts"
      ],
      "@dcapal/api-client/*": [
        "../packages/api-client/src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@demo/*": [
        "./demo/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@images/*": [
        "./images/*"
      ],
      "@routes/*": [
        "./src/routes/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@workers/*": [
        "./src/workers/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
