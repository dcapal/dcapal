{
  "projectId": "930e2c0e-5fe1-44fc-acea-3da709823eac",
  "shape": "storybook",
  "pkg": "@dcapal/frontend",
  "globalName": "Dcapal",
  "buildCmd": "node scripts/build-design-system-bundle.mjs",
  "entry": ".design-sync/dist/index.js",
  "cssEntry": "index.css",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "storyImports": {
    "shim": [
      "/src/design-system/components/ui/",
      "/src/design-system/components/patterns/"
    ]
  },
  "provider": {
    "component": "DcapalThemeScope"
  },
  "libOverrides": {
    "source-storybook.mjs": "stories are title-level catalogs; map story ids to component exports via .design-sync/story-owners.json and exclude Compositions/Foundations titles"
  },
  "overrides": {
    "AppShell": {
      "cardMode": "column",
      "viewport": "900x1400"
    },
    "FloatingActionMenu": {
      "cardMode": "column",
      "viewport": "900x1400"
    },
    "PortfolioFooter": {
      "cardMode": "column"
    },
    "PortfolioIndex": {
      "cardMode": "column",
      "viewport": "900x1400"
    },
    "PortfolioSetupPage": {
      "cardMode": "column",
      "viewport": "900x1400"
    },
    "PortfolioWorkspace": {
      "cardMode": "column",
      "viewport": "900x1400"
    },
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "DialogStates"
    },
    "InvestmentProposal": {
      "viewport": "900x1400"
    },
    "PortfolioAssetCollection": {
      "viewport": "900x1400"
    },
    "InvestmentPlanForm": {
      "viewport": "900x1400"
    },
    "InvestmentResult": {
      "viewport": "900x1400"
    },
    "DriftOverview": {
      "viewport": "900x1400"
    },
    "StickyActionBar": {
      "viewport": "900x1400"
    },
    "ProposedTransactionCollection": {
      "viewport": "900x1400"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}