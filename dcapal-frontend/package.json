    "@babel/preset-typescript": "catalog:",
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "istanbul-lib-coverage": "catalog:",
    "istanbul-lib-report": "catalog:",
    "istanbul-reports": "catalog:",
    "autoprefixer": "catalog:",
    "babel-loader": "catalog:",
