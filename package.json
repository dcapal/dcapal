{
  "name": "dcapal",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "overrides": {
      "qs": "^6.16.1",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "webpack-dev-middleware@<7.4.6": "^7.4.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gcqx-w48m-w2h4"
      ]
    }
  },
  "scripts": {
    "api-client:generate": "make export-openapi && pnpm --filter @dcapal/api-client generate",
    "frontend:dev": "pnpm --filter @dcapal/frontend dev",
    "frontend:dev:ci": "pnpm --filter @dcapal/frontend dev:ci",
    "frontend:build": "pnpm --filter @dcapal/frontend build",
    "frontend:build:dev": "pnpm --filter @dcapal/frontend build:dev",
    "frontend:lint": "pnpm --filter @dcapal/frontend lint",
    "frontend:format": "pnpm --filter @dcapal/frontend format",
    "frontend:typecheck": "pnpm --filter @dcapal/frontend typecheck",
    "frontend:test": "pnpm --filter @dcapal/frontend test",
    "frontend:test:e2e": "pnpm --filter @dcapal/frontend test:e2e",
    "frontend:test:e2e:smoke": "pnpm --filter @dcapal/frontend test:e2e:smoke",
    "frontend:test:e2e:production-mock": "pnpm --filter @dcapal/frontend test:e2e:production-mock",
    "frontend:test:e2e:coverage": "pnpm --filter @dcapal/frontend test:e2e:coverage",
    "frontend:coverage:report": "pnpm --filter @dcapal/frontend coverage:report"
  }
}
